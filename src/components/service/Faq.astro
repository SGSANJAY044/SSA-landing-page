---
/** Native <details> accordion; height animates via ::details-content where supported. */
const { faqs } = Astro.props;
---

<div class="faq">
  {
    faqs.map((f) => (
      <details class="faq__item" name="faq">
        <summary>
          <span>{f.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <p class="faq__answer">{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 8px;
  }

  .faq__item {
    border-radius: var(--radius-m);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.4s var(--ease-out),
      content-visibility 0.4s allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 56px;
    padding: 12px 16px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 50%;
    background: var(--gold-soft);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 8px auto;
    height: 2px;
    margin-top: -1px;
    border-radius: 2px;
    background: var(--text);
    transition: rotate 0.3s var(--ease-out);
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__icon::after {
    rotate: 0deg;
  }

  .faq__answer {
    padding: 0 16px 16px;
    color: var(--text-muted);
  }
</style>
