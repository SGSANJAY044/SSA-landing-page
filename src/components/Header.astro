---
import { site } from '../data/site.js';
import { t, localePath, otherLocale, asset } from '../i18n/ui.js';

const { locale, path, backHref } = Astro.props;
const other = otherLocale(locale);
---

<header class="header">
  <div class="wrap header__inner">
    {
      backHref ? (
        <a class="header__back" href={backHref} aria-label={t(locale, 'nav.allServices')}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ) : null
    }
    <a class="header__brand" href={localePath(locale, '/')}>
      <img data-brand-mark src={asset('/logo-mark.webp')} alt="" width="47" height="36" />
      <span class="header__name">
        <span class="header__name-main">{site.nameLines[locale][0]}</span>
        <span class="header__name-sub">{site.nameLines[locale][1]}</span>
      </span>
    </a>
    <a class="header__lang" href={localePath(other, path)} hreflang={other} lang={other} aria-label={t(locale, 'nav.switchLabel')}>
      {t(locale, 'nav.switchTo')}
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
    view-transition-name: site-header;
  }

  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header__back {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: -8px;
    border-radius: 50%;
    color: var(--text);
  }

  .header__back svg {
    width: 22px;
    height: 22px;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--brand);
  }

  :global(:root[data-theme='dark']) .header__brand {
    color: var(--text);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .header__brand {
      color: var(--text);
    }
  }

  .header__brand img {
    width: 47px;
    height: 36px;
    border-radius: 8px;
    flex: none;
    background: #faf2e7; /* logo cream, so the green mark reads in dark mode too */
  }

  :global(html.intro-pending) [data-brand-mark] {
    visibility: hidden;
  }

  /* Two lines like the logo wordmark, sized to fit 320px phones with the back button */
  .header__name {
    display: grid;
    line-height: 1.15;
    min-width: 0;
  }

  /* Never truncated: if a narrow phone can't fit it, it wraps (balanced) instead */
  .header__name-main {
    font-size: clamp(0.8rem, 3.7vw, 1rem);
    text-wrap: balance;
  }


  .header__name-sub {
    font-size: clamp(0.58rem, 2.5vw, 0.68rem);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  /* Tamil glyphs stack vowel signs above and below the line, so the two
     lines need more room than Latin text, and tracking breaks conjuncts. */
  :global(:lang(ta)) .header__name {
    line-height: 1.4;
    gap: 1px;
  }

  :global(:lang(ta)) .header__name-sub {
    letter-spacing: 0;
    font-size: clamp(0.66rem, 2.8vw, 0.74rem);
  }

  :global(:root[data-theme='dark']) .header__name-sub {
    color: var(--gold);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .header__name-sub {
      color: var(--gold);
    }
  }

  .header__lang {
    margin-left: auto;
    flex: none;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
